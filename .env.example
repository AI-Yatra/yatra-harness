# Yatra Harness environment file.
#
# Copy this file to `.env` and fill in the keys you need.
# `.env` is gitignored; never commit it.
#
# DASHSCOPE_API_KEY: Qwen Cloud / Alibaba DashScope (qwen-plus, qwen-max, ...)
#   Get one at https://dashscope.console.aliyun.com/apiKey
# DASHSCOPE_API_KEY=sk-ws-...

# OPENAI_API_KEY: OpenAI (gpt-4o, gpt-4o-mini, ...)
#   https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ANTHROPIC_API_KEY: Anthropic (claude-sonnet, claude-opus, ...)
#   https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Local models (Ollama, vLLM) need no key — just point the config at
# the local base_url (see configs/local.yaml).
